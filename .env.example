# .env.example
#
# Implements: docs/03-design/system-architecture.md ADR-015 (configuration read from
# process.env at first use, never at build) and NFR-015 (secrets from environment
# only). Every variable C-12 (src/lib/runtime-config.ts) reads is listed here.
#
# Copy this file to `.env` at the repo root, fill in real values, and never commit
# `.env`. `.gitignore` already excludes `.env` and `.env.*` except this file.

# --- SMTP relay (ADR-004, C-15) ---
# Host name of the outbound SMTP relay. Missing or invalid -> contact endpoint
# returns SEND_FAILED.
SMTP_HOST=smtp.example.com

# SMTP port. Port 465 uses implicit TLS; every other port uses STARTTLS
# (requireTLS: true). Must be an integer between 1 and 65535.
SMTP_PORT=587

# SMTP authentication username.
SMTP_USER=smtp-username

# SMTP authentication password. Obtain from the SMTP relay provider. Never commit
# the real value.
SMTP_PASSWORD=smtp-password-placeholder

# --- Outbound mail identity (ADR-004, C-14) ---
# The From address on every enquiry email. Must be an address the SMTP relay is
# authorized to send as (check SPF/DKIM alignment with the relay provider).
MAIL_FROM=website@example.com

# The sales mailbox that receives every enquiry (FR-035). This is the sole envelope
# recipient.
SALES_MAILBOX=sales@example.com

# --- Cloudflare Turnstile (ADR-007) ---
# Public site key rendered into the Contact page. Not a secret by itself, but read
# at request time only, never baked into a static build (NFR-015).
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key used server-side to call the Siteverify API. Obtain from the
# Cloudflare Turnstile dashboard for the Managed widget (FR-048). Never commit the
# real value.
TURNSTILE_SECRET_KEY=turnstile-secret-placeholder

# --- Server bind address (ADR-015, C-01) ---
# Both have defaults in server.ts (PORT=4321, HOST=0.0.0.0) if unset. Set explicitly
# in every deployment environment for clarity.
PORT=4321
HOST=0.0.0.0
