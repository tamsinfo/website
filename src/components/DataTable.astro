---
/**
 * DataTable — table shell (design-system.md section 7.8): Home "What are you
 * facing?" and the Careers open-roles table. Semantic <table>, no sorting.
 *
 * Props:
 *   caption: string                 Accessible table name (rendered visually hidden).
 *   columns: { label: string; class?: string }[]
 *                                   Header cells; `class` sets width utilities,
 *                                   e.g. "xl:w-30" (120px).
 *   headerTone?: "sunk" | "limestone"   Header row fill: bg-sunk (Home, default) or
 *                                   limestone-100 (Careers).
 *   emptyMessage?: string           Rendered as one full-width row when no rows are
 *                                   slotted (SCR-003 empty state: "No openings available").
 *   class?: string
 * Slot: <tr role="row"> rows. Use TABLE_ROW_CLASS with STACKED_ROW_CLASS, and
 * TABLE_CELL_CLASS with STACKED_CELL_CLASS (role="cell"), from src/lib/ui-classes.ts,
 * so rows alternate surface / limestone-50 with hairline dividers and stack on Mobile.
 *
 * Below xl the table renders stacked (G4 revision request 2): the header labels wrap
 * as one line of text and each row is a block, so nothing is cut off at 320px and the
 * page never scrolls sideways (NFR-020). The explicit ARIA table roles keep the table
 * semantics that display:block would otherwise remove. Desktop is a normal table.
 */
import {
  STACKED_CELL_CLASS,
  STACKED_ROW_CLASS,
  TABLE_CELL_CLASS,
  TABLE_ROW_CLASS,
  tableHeaderClass,
  type TableHeaderTone,
} from "../lib/ui-classes";

interface Column {
  label: string;
  class?: string;
}

interface Props {
  caption: string;
  columns: Column[];
  headerTone?: TableHeaderTone;
  emptyMessage?: string;
  class?: string;
}

const { caption, columns, headerTone = "sunk", emptyMessage, class: className } = Astro.props;
const hasRows = Astro.slots.has("default");
---

<div
  class:list={["overflow-clip rounded-lg border border-border bg-surface", className]}
  role="region"
  aria-label={caption}
>
  <table class="block w-full border-collapse text-left font-sans xl:table" role="table">
    <caption class="sr-only">{caption}</caption>
    <thead class:list={["block xl:table-header-group", tableHeaderClass(headerTone)]} role="rowgroup">
      <tr
        class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-border px-5 py-4 xl:table-row xl:h-12 xl:p-0"
        role="row"
      >
        {
          columns.map((column) => (
            <th
              scope="col"
              role="columnheader"
              class:list={[
                "block font-mono text-11 font-medium uppercase leading-3.5 tracking-label-wide text-text-muted xl:table-cell xl:px-8",
                column.class,
              ]}
            >
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class="block xl:table-row-group" role="rowgroup">
      {
        hasRows ? (
          <slot />
        ) : (
          emptyMessage !== undefined && (
            <tr class:list={[TABLE_ROW_CLASS, STACKED_ROW_CLASS]} role="row">
              <td
                colspan={columns.length}
                role="cell"
                class:list={[TABLE_CELL_CLASS, STACKED_CELL_CLASS, "text-15/body text-text-muted"]}
              >
                {emptyMessage}
              </td>
            </tr>
          )
        )
      }
    </tbody>
  </table>
</div>
