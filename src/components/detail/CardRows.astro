---
/**
 * CardRows — detail-page card grid (design-system.md section 7.7). Each data row is
 * one Desktop row whose cards share the width equally, as captured; Mobile stacks
 * every card. Card titles are <h3> (ui-specification.md section 0).
 *
 * The shared Card component uses the compact 19px title and 14px body of Home and
 * 404; the detail captures use 22px or 20px titles and 15px body, so this family
 * renders its own tile.
 *
 * Props:
 *   block: CardsBlock   See src/lib/detail-page.ts.
 *   tone: "light" | "dark"
 */
import type { BlockTone, CardsBlock } from "../../lib/detail-page";
import {
  cardTitleClasses,
  dividerClasses,
  mutedTextClasses,
  panelClasses,
  strongTextClasses,
} from "../../lib/detail-classes";

interface Props {
  block: CardsBlock;
  tone: BlockTone;
}

const { block, tone } = Astro.props;
const striped = block.accentTop === true;
---

<div class="flex flex-col gap-6">
  {
    block.rows.map((row) => (
      <ul class="flex flex-col gap-6 xl:flex-row">
        {row.map((card) => (
          <li
            class:list={[
              "flex flex-col rounded-lg xl:grow xl:basis-0",
              striped ? "overflow-clip" : "p-6 xl:p-8",
              panelClasses(tone),
            ]}
          >
            {striped && <span class="h-1 shrink-0 bg-primary" aria-hidden="true" />}
            <div class:list={["flex grow flex-col", striped ? "gap-3 p-6 xl:p-8" : "gap-4"]}>
              <h3
                class:list={[
                  "font-display font-semibold tracking-snug",
                  cardTitleClasses(block.titleSize),
                  strongTextClasses(tone),
                ]}
              >
                {card.title}
              </h3>
              <p
                class:list={[
                  "text-15/body",
                  card.note !== undefined && "grow",
                  mutedTextClasses(tone),
                ]}
              >
                {card.body}
              </p>
              {card.note !== undefined && (
                <p class:list={["border-t pt-3 text-14/snug text-slate-500 italic", dividerClasses(tone)]}>
                  {card.note}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    ))
  }
</div>
