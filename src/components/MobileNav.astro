---
/**
 * MobileNav — the Mobile header's menu control and full-width menu panel (C-23,
 * ADR-012, design-system.md section 7.14). Shown below xl only (by SiteHeader).
 *
 * Props:
 *   current?: NavKey    Menu row to highlight.
 *   pathname: string    Current path, for aria-current.
 *
 * A native <details>/<summary> opens and closes with no JavaScript (FR-015,
 * FR-051). Each dropdown family is a nested <details>. The panel is positioned
 * against the <header> (SiteHeader is `relative`). nav-menu-client.ts adds Escape
 * close and close-on-link-follow.
 */
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { DISCOVERY_CALL_HREF, PRIMARY_NAV, isCurrentHref, type NavKey } from "../lib/site-routes";

interface Props {
  current?: NavKey | undefined;
  pathname: string;
}

const { current, pathname } = Astro.props;
const rowClass =
  "flex w-full items-center justify-between py-5 font-display text-24 font-medium leading-7.5 tracking-tight";
---

<details id="mobile-menu" data-mobile-menu class="group/menu">
  <summary class="-mr-2 flex size-11 items-center justify-center text-text-inverse">
    <span class="sr-only group-open/menu:hidden">Open menu</span>
    <span class="sr-only hidden group-open/menu:inline">Close menu</span>
    <Icon name="menu" class="size-5.5 group-open/menu:hidden" />
    <Icon name="close" class="hidden size-5.5 group-open/menu:block" />
  </summary>
  <nav
    aria-label="Primary"
    class="absolute inset-x-0 top-full z-50 min-h-screen border-t border-border-inverse bg-surface-inverse px-5 pt-2 pb-6"
  >
    <ul class="flex flex-col">
      {
        PRIMARY_NAV.map((item) => {
          const tone = item.key === current ? "text-accent-inverse" : "text-text-inverse";
          if (item.kind === "link") {
            return (
              <li class="border-b border-border-inverse">
                <a
                  href={item.href}
                  class:list={[rowClass, tone]}
                  aria-current={isCurrentHref(item.href, pathname) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }
          return (
            <li class="border-b border-border-inverse">
              <details class="group/sub">
                <summary class:list={[rowClass, tone]}>
                  {item.label}
                  <Icon name="plus" class="size-4.5 text-text-inverse-muted group-open/sub:hidden" />
                  <Icon
                    name="minus"
                    class="hidden size-4.5 text-text-inverse-muted group-open/sub:block"
                  />
                </summary>
                <ul class="flex flex-col pb-4">
                  {item.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class:list={[
                          "block py-2 font-sans text-16/snug hover:text-text-inverse",
                          isCurrentHref(link.href, pathname)
                            ? "text-accent-inverse"
                            : "text-text-inverse-muted",
                        ]}
                        aria-current={isCurrentHref(link.href, pathname) ? "page" : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          );
        })
      }
    </ul>
    <Button href={DISCOVERY_CALL_HREF} variant="inverse" size="lg" block class="mt-4">
      Contact us
    </Button>
  </nav>
</details>
