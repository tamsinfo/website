---
/**
 * SiteFooter — the site footer on every screen (C-25; ui-specification.md
 * section 1; design-system.md section 7.15). Copy transcribed from
 * desktop/not-found.jsx and mobile/not-found.jsx (identical on every screen).
 *
 * Props: none.
 *
 * Every link is a plain <a> and navigates without JavaScript (FR-051). Unshipped
 * destinations (Terms, Cookies, Sitemap) are "#" (FR-012). The oversized wordmark
 * band is aria-hidden: it repeats the brand name.
 *
 * Known limitation (design-system.md section 1): the trademark line uses
 * slate-600 on surface-inverse (2.1:1). Do not darken it.
 */
import Icon from "./Icon.astro";
import LogoMark from "./LogoMark.astro";
import { FOOTER_COLUMNS, FOOTER_LEGAL_LINKS } from "../lib/site-routes";
import { CONTAINER_CLASS, GUTTER_CLASS } from "../lib/ui-classes";

const contactRows = [
  { icon: "pin", text: "Bengaluru, Karnataka" },
  { icon: "phone", text: "+91 80 4130 1039" },
  { icon: "mail", text: "sales@tamsinfotech.com" },
] as const;
---

<footer class="w-full overflow-clip bg-surface-inverse font-sans">
  <div class:list={["border-t border-border-inverse pt-20 pb-12", GUTTER_CLASS]}>
    <div class:list={[CONTAINER_CLASS, "flex flex-col items-start gap-6 xl:flex-row xl:gap-16"]}>
      <div class="flex w-full flex-col gap-5 xl:w-85 xl:shrink-0">
        <p class="flex items-center gap-3">
          <LogoMark class="size-6" />
          <span
            class="font-display text-17 font-bold leading-5.5 tracking-tight text-text-inverse xl:text-18"
            >TAMS Infotech</span
          >
        </p>
        <p class="text-14/body text-text-inverse-muted">
          SAP Gold Partner delivering S/4HANA Cloud implementation, managed services and custom
          applications to Indian manufacturers — backed by our own SAP-integrated products.
        </p>
        <ul class="flex flex-col gap-3 pt-2">
          {
            contactRows.map((row) => (
              <li class="flex items-center gap-3">
                <Icon name={row.icon} class="size-4 text-slate-500" />
                <span class="text-14 leading-4.5 text-text-inverse-muted">{row.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        FOOTER_COLUMNS.map((column) => (
          <nav aria-labelledby={column.id} class="flex flex-col gap-4 xl:grow xl:basis-0">
            <h2
              id={column.id}
              class="font-mono text-11 font-medium uppercase leading-3.5 tracking-wider text-slate-500"
            >
              {column.heading}
            </h2>
            <ul class="flex flex-col gap-4">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-14/snug text-text-inverse-muted hover:text-text-inverse">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class:list={["border-t border-border-inverse py-5", GUTTER_CLASS]}>
    <div
      class:list={[CONTAINER_CLASS, "flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between xl:gap-10"]}
    >
      <p class="text-13 leading-4 text-slate-500">© 2026 TAMS Infotech Pvt. Ltd.</p>
      <nav aria-label="Legal">
        <ul class="flex items-center gap-6">
          {
            FOOTER_LEGAL_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-13 leading-4 text-slate-500 hover:text-text-inverse">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class:list={["border-t border-border-inverse py-5", GUTTER_CLASS]}>
    <p class:list={[CONTAINER_CLASS, "text-12/snug text-slate-600"]}>
      SAP, S/4HANA, RISE with SAP and GROW with SAP are trademarks of SAP SE. TAMS Infotech is an
      independent SAP partner and is not affiliated with SAP SE beyond its partner agreement.
    </p>
  </div>

  <div
    class:list={["flex h-24 shrink-0 items-start justify-center overflow-clip", GUTTER_CLASS]}
    aria-hidden="true"
  >
    <span
      class="w-max font-display text-56/none font-bold whitespace-nowrap tracking-wordmark text-wordmark xl:text-132/none"
    >
      TAMS INFOTECH
    </span>
  </div>
</footer>
