---
/**
 * Section — full-bleed page section with the design's gutters and rhythm
 * (design-system.md section 3). Mobile: px-5, py-12. Desktop (xl): px-20, py-24.
 * The background runs edge to edge at any width; content is centred in
 * CONTAINER_CLASS (G4 revision request 2).
 *
 * Props:
 *   tone?: "bg" | "sunk" | "surface" | "inverse"   Background. Default "bg".
 *   padding?: "default" | "loose" | "none"
 *            "default" = py-12 / xl:py-24; "loose" = py-32 (dark full-bleed bands);
 *            "none" = gutters only.
 *   labelledby?: string   id of the section's heading, for aria-labelledby.
 *   id?: string
 *   class?: string        Extra classes on the <section>.
 *   innerClass?: string   Replaces the inner layout classes (default
 *                         "flex flex-col gap-8 xl:gap-12").
 * Slot: section content.
 */
import {
  CONTAINER_CLASS,
  GUTTER_CLASS,
  sectionToneClass,
  type SectionTone,
} from "../lib/ui-classes";

interface Props {
  tone?: SectionTone;
  padding?: "default" | "loose" | "none";
  labelledby?: string;
  id?: string;
  class?: string;
  innerClass?: string;
}

const {
  tone = "bg",
  padding = "default",
  labelledby,
  id,
  class: className,
  innerClass = "flex flex-col gap-8 xl:gap-12",
} = Astro.props;

const paddingClass = {
  default: "py-12 xl:py-24",
  loose: "py-32",
  none: "",
}[padding];
---

<section
  {id}
  aria-labelledby={labelledby}
  class:list={["w-full font-sans", GUTTER_CLASS, sectionToneClass(tone), paddingClass, className]}
>
  <div class:list={[CONTAINER_CLASS, innerClass]}>
    <slot />
  </div>
</section>
