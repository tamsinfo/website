---
/**
 * TextLink — text link with trailing arrow ("Explore", "Contact us" on 404).
 * design-system.md section 7.1 "Text link + icon".
 *
 * Props:
 *   href: string
 *   tone?: "light" | "dark"   primary on light (default), accent-inverse on dark.
 *   class?: string
 * Slot: the link text.
 */
import Icon from "./Icon.astro";
import type { Tone } from "../lib/ui-classes";

interface Props {
  href: string;
  tone?: Tone;
  class?: string;
}

const { href, tone = "light", class: className } = Astro.props;
---

<a
  {href}
  class:list={[
    "inline-flex items-center gap-2 self-start font-sans text-15 font-semibold leading-4.5 hover:underline",
    tone === "dark" ? "text-accent-inverse" : "text-primary",
    className,
  ]}
>
  <slot />
  <Icon name="arrow-right" class="size-3.75" />
</a>
