---
/**
 * SCR-026 to SCR-031 — Industries detail pages (FR-047, US-013).
 * One prerendered page per INDUSTRY_ROUTES entry. Any other slug, and "/industries"
 * itself, has no page and falls through to the 404 page (FR-047 edge cases).
 * Content: src/lib/detail-content/industries.ts, transcribed per snapshot.
 */
import DetailPage from "../../components/detail/DetailPage.astro";
import { INDUSTRIES_FAMILY } from "../../lib/detail-content/industries";
import { type DetailRouteEntry, detailRoutes } from "../../lib/detail-page";

export function getStaticPaths() {
  return detailRoutes(INDUSTRIES_FAMILY).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: DetailRouteEntry;
}

const { entry } = Astro.props;
---

<DetailPage {entry} />
